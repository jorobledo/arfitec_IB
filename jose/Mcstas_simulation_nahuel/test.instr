DEFINE INSTRUMENT test(Nkds=1, source=1)

DECLARE
%{

double epsilon;

/* Ecran */
double e1;
double L1;
double r1;


/* Longueurs */

double L2;
double L3;

double e_cd;
double e_poly;


/* Rayon */

double r2_ext;
double r3_ext;

double r2_int_in;
double r2_int_out;

double r3_int;


%}

USERVARS
%{
%}

INITIALIZE
%{

epsilon = 1e-6;

e1 = 0.07;
L1 = 0.21;
r1 = 0.025;



L2 = 0.380;
L3 = 0.587;

e_cd = 0.001;
e_poly = 0.050;

r2_ext = 0.051;
r3_ext = 0.070;

r2_int_in = 0.018;
r2_int_out = 0.0075;

r3_int = 0.010;

%}

TRACE

COMPONENT origin = Progress_bar()
AT (0, 0, 0) RELATIVE ABSOLUTE

//   filename = "./kdsource_files/kds_complet.xml",
// filename = "./kdsource_files/test.xml", 

COMPONENT source1 = KDSource(
  filename = "./kdsource_files/kds_complet.xml", 
nloop=Nkds) 
WHEN (source = 1)
AT (0, 0, 0) RELATIVE  ABSOLUTE

// COMPONENT CompInstanceName = Source_simple(
//   yheight = 0.15,
//   xwidth = 0.15,
//   dist = 0.5,
//   focus_xw = 0.1,
//   focus_yh = 0.1,
//   E0 = 25,
//   dE = 10) 
// WHEN (source = 2)
// AT (0, 0, 0) RELATIVE  ABSOLUTE

// COMPONENT mcplout1 = MCPL_output( filename="myoutput1.mcpl" , weight_mode=1)
// AT(0,0,0) RELATIVE PREVIOUS

COMPONENT arm1 = Arm()
AT (0,0,0.045) RELATIVE ABSOLUTE

// Initialize Union Simulation 1
// -----------------------------

COMPONENT init_1 = Union_init()
AT (0,0,0) RELATIVE arm1

/* Materials */
COMPONENT polyethylene_process = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT cadmium_process = NCrystal_process(cfg = "Cd_sg194_cod9012436.ncmat", init="init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT polyethylene = Union_make_material(
 process_string = "polyethylene_process",
 init = "init_1",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm1

COMPONENT cadmium = Union_make_material(
 process_string = "cadmium_process",
 init = "init_1",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm1

/* Pantalla neutronica */
COMPONENT box_cd_1 = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e1,
    priority = 10,
    material_string = "cadmium",
    init = "init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT box_poly_1 = Union_box(
    xwidth = L1-2*e_cd,
    yheight = L1-2*e_cd,
    zdepth = e1-2*e_cd,
    priority = 20,
    material_string = "polyethylene",
    init = "init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT cylindre_cd_1 = Union_cylinder(
    yheight = e1-epsilon,
    radius = r1+2*e_cd,
    priority = 30,
    material_string = "cadmium",
    init = "init_1")
AT (0,0,0) RELATIVE arm1
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cylindre_vacuum_1 = Union_cylinder(
    yheight = e1+epsilon,
    radius = r1,
    priority = 40,
    material_string = "Vacuum",
    init = "init_1")
AT (0,0,0) RELATIVE arm1
ROTATED (90,0,0) RELATIVE ABSOLUTE

/* slit */
COMPONENT slit1_cd = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e_cd,
    priority = 50,
    material_string = "cadmium",
    init = "init_1")
AT (0,0,0.06) RELATIVE arm1

COMPONENT slit1_hole = Union_box(
    xwidth = 0.0035,
    yheight = 0.01,
    zdepth = e_cd+epsilon,
    priority = 60,
    material_string = "Vacuum",
    init = "init_1")
AT (0,0,0.06) RELATIVE arm1

COMPONENT master_1 = Union_master(init = "init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT stop_1 = Union_stop()
AT (0,0,0) RELATIVE arm1

// End Union simulation 1
// ----------------------

// COMPONENT arm_mcplout2 = Arm()
// AT(0,0,1e-5) RELATIVE slit1_hole

// COMPONENT mcplout2 = MCPL_output( filename="myoutput2.mcpl", weight_mode=1 )
// AT (0,0,0) RELATIVE PREVIOUS


// Chopper
// -----------------------------


COMPONENT chopper = CadmiumDiskChopper(
  xwidth = 0.001,
  radius = 0.07,
  yheight = 0.01,
  nu = 66.666,
  nslit = 1,
  isfirst = 1,
  n_pulse = 3,
  proba = 0.5,
  thick = 0.1,
  squared_limit=0.15
  )
AT (0,0,0.13) RELATIVE ABSOLUTE


COMPONENT arm_mcplout3 = Arm()
AT(0,0,1e-5) RELATIVE chopper

COMPONENT mcplout3 = MCPL_output( filename="myoutput3.mcpl", weight_mode=1 )
AT (0,0,0.14) RELATIVE ABSOLUTE

// Initialize Union Simulation 2
// -----------------------------


COMPONENT arm2 = Arm()
AT (0,0,0.3065) RELATIVE chopper

COMPONENT init_2 = Union_init()
AT (0,0,0) RELATIVE arm2

COMPONENT diffusion_polyethylene_2 = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT diffusion_cd_2 = NCrystal_process(cfg = "Cd_sg194_cod9012436.ncmat", init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT air_process = NCrystal_process(
 cfg = "gasmix::air/25C/1.0atm/0.30relhumidity", init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT polyethylene_2 = Union_make_material(
 process_string = "diffusion_polyethylene_2",
 init = "init_2",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm2

COMPONENT cadmium_2 = Union_make_material(
 process_string = "diffusion_cd_2",
 init = "init_2",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm2

COMPONENT air = Union_make_material(
 process_string = "air_process", my_absorption = 0.00726555,
 refraction_SLD = 4.15904E-09, init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT slit2_cd = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e_cd,
    priority = 2,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,-L2/2-0.05) RELATIVE arm2

COMPONENT slit2_hole = Union_box(
    xwidth = 0.0035,
    yheight = 0.01,
    zdepth = e_cd+epsilon,
    priority = 3,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,-L2/2-0.05) RELATIVE arm2


/*==========================================================
  Collimator between chopper and sample
==========================================================*/

COMPONENT air_box = Union_box(
    xwidth = r2_ext+0.5,
    zdepth=L2-epsilon+0.01,
    yheight = r2_ext+0.5,
    priority = 5,
    material_string = "air",
    init = "init_2")
AT (0,0,0) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_tube_outer_2 = Union_cylinder(
    yheight = L2-epsilon,
    radius = r2_ext,
    priority = 10,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,0) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_front_2 = Union_cylinder(
    yheight = e_cd,
    radius = r2_ext-epsilon,
    priority = 30,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,-L2/2+e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT cd_back_2 = Union_cylinder(
    yheight = e_cd,
    radius = r2_ext-epsilon,
    priority = 50,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,L2/2-e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_front_2 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r2_ext-2*e_cd,
    priority = 70,
    material_string = "polyethylene_2",
    init = "init_2")
AT (0,0,-L2/2+e_poly/2+e_cd) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT poly_back_2 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r2_ext-2*e_cd,
    priority = 90,
    material_string = "polyethylene_2",
    init = "init_2")
AT (0,0,L2/2-e_poly/2-e_cd) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT front_void_2 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r2_int_in,
    priority = 100,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,-L2/2+e_poly/2+e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT back_void_2 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r2_int_out,
    priority = 110,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,L2/2-e_poly/2-e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT center_void_2 = Union_cylinder(
    yheight = L2-2*e_poly-2*e_cd+2*epsilon,
    radius = r2_ext-2*e_cd,
    priority = 120,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,0) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT logger_xz_colim1 = Union_logger_2D_space(
  D_direction_2 = "x",
  D2_min = -0.06,
  D2_max = 0.06,
  n1 = 100,
  D_direction_1 = "z",
  D1_min = -0.25,
  D1_max = 0.20,
  n2 = 100,
  filename = "logger_colim1",
  init = "init_2") 
 AT (0, 0, 0) RELATIVE  arm2


COMPONENT master_2 = Union_master(init = "init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT stop_2 = Union_stop()
AT (0,0,0) RELATIVE arm2

COMPONENT arm_mcplout4 = Arm()
AT (0,0,L2/2-e_poly/2-e_cd/2+e_cd+e_poly+2*epsilon) RELATIVE arm2

COMPONENT mcplout4 = MCPL_output( filename="myoutput4.mcpl", weight_mode=1 )
AT (0,0,0.65) RELATIVE ABSOLUTE



/* ------------------------------------------------------------------
   Echantillon NCrystal
   diamètre = 30.1 mm
   épaisseur = 6.65 mm
   ------------------------------------------------------------------ */

// COMPONENT sample = NCrystal_sample(
//   cfg = "Cd_sg194_cod9012436.ncmat",
//   radius = 0.05,
//   yheight = 0.001,
//   multscat = 0
// )
// AT (0,0,0.315) RELATIVE arm2
// ROTATED (90,0,0) RELATIVE arm2

//// ----------------------------------------
// COMPONENT sample = NCrystal_sample(
//   cfg = "Cu_sg225.ncmat",
//   radius = 0.01505,
//   yheight = 0.00665,
//   multscat = 0
// )
// AT (0,0,0.315) RELATIVE arm2
// ROTATED (90,0,0) RELATIVE arm2
//// ----------------------------------------

// Cu_sg225.ncmat
// Cd_sg194_cod9012436.ncmat

// COMPONENT arm_mcplout5 = Arm()
// AT (0,0,0.001) RELATIVE sample
// ROTATED (-90, 0, 0) RELATIVE sample

// COMPONENT mcplout5 = MCPL_output( filename="myoutput5.mcpl", weight_mode=1 )
// AT (0,0,0) RELATIVE PREVIOUS


// Inicio de Union Simulation 3
// -----------------------------

COMPONENT arm3 = Arm()
AT (0,0,1.2235) RELATIVE arm2

COMPONENT init_3 = Union_init()
AT (0,0,0) RELATIVE arm3

COMPONENT diffusion_polyethylene_3 = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT diffusion_cd_3 = NCrystal_process(cfg = "Cd_sg194_cod9012436.ncmat", init="init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT polyethylene_3 = Union_make_material(
 process_string = "diffusion_polyethylene_3",
 init = "init_3",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm3

COMPONENT cadmium_3 = Union_make_material(
 process_string = "diffusion_cd_3",
 init = "init_3",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm3


COMPONENT cd_tube_outer_3 = Union_cylinder(
    yheight = L3-epsilon,
    radius = r3_ext,
    priority = 10,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,0) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_front_3 = Union_cylinder(
    yheight = e_cd,
    radius = r3_ext-epsilon,
    priority = 30,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,-L3/2+e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_back_3 = Union_cylinder(
    yheight = e_cd,
    radius = r3_ext-epsilon,
    priority = 50,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,L3/2-e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_front_3 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r3_ext-2*e_cd,
    priority = 70,
    material_string = "polyethylene_3",
    init = "init_3")
AT (0,0,-L3/2+e_poly/2+e_cd) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_back_3 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r3_ext-2*e_cd,
    priority = 90,
    material_string = "polyethylene_3",
    init = "init_3")
AT (0,0,L3/2-e_poly/2-e_cd) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT front_void_3 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r3_int,
    priority = 100,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,-L3/2+e_poly/2+e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT back_void_3 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r3_int,
    priority = 110,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,L3/2-e_poly/2-e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT center_void_3 = Union_cylinder(
    yheight = L3-2*e_poly-2*e_cd+2*epsilon,
    radius = r3_ext-2*e_cd,
    priority = 120,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,0) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT master_3 = Union_master(init = "init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT stop_3 = Union_stop()
AT (0,0,0) RELATIVE arm3

// COMPONENT arm_mcplout6 = Arm()
// AT (0,0,L3/2-e_poly/2-e_cd/2) RELATIVE arm3

COMPONENT tof = TOF_monitor(
  nt = 2000,
  xwidth = 0.1524,
  yheight = 0.0762,
  tmin = -5000,
  tmax = 10000,
  restore_neutron=1
)
AT (0,0,0.3615) RELATIVE arm3

COMPONENT mcplout6 = MCPL_output( filename="myoutput6.mcpl", weight_mode=1 )
AT (0,0,2.0) RELATIVE ABSOLUTE


FINALLY
%{
%}

END