DEFINE INSTRUMENT template_simple(use_sample=1, Nkds=10)

DECLARE
%{

double epsilon;

/* Ecran */
double e1;
double L1;
double r1;


/* Longueurs */

double L2;
double L3;

double e_cd;
double e_poly;


/* Rayon */

double r2_ext;
double r3_ext;

double r2_int_in;
double r2_int_out;

double r3_int;


%}

USERVARS
%{
%}

INITIALIZE
%{

epsilon = 1e-6;

e1 = 0.07;
L1 = 0.21;
r1 = 0.025;



L2 = 0.380;
L3 = 0.587;

e_cd = 0.001;
e_poly = 0.050;

r2_ext = 0.051;
r3_ext = 0.070;

r2_int_in = 0.018;
r2_int_out = 0.0075;

r3_int = 0.010;

%}

TRACE

COMPONENT origin = Progress_bar()
AT (0, 0, 0) RELATIVE ABSOLUTE

/* ------------------------------------------------------------------
   Source Maxwellienne
   ------------------------------------------------------------------ */

COMPONENT CompInstanceName = KDSource(
  filename = "/home2/home/rbilly/simulation_nahuel/instrument_mcstas/bw_cst/kds_complet.xml",
nloop=Nkds) 
 AT (0, 0, 0) RELATIVE  ABSOLUTE


COMPONENT arm1 = Arm()
AT (0,0,0.045) RELATIVE ABSOLUTE

COMPONENT init_1 = Union_init()
AT (0,0,0) RELATIVE arm1

COMPONENT diffusion_polyethylene_1 = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT polyethylene_1 = Union_make_material(
 process_string = "diffusion_polyethylene_1",
 init = "init_1",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm1

COMPONENT cadmium_1 = Union_make_material(
 process_string = "diffusion_polyethylene_1",
 init = "init_1",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm1


COMPONENT box_cd_1 = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e1,
    priority = 10,
    material_string = "cadmium_1",
    init = "init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT box_poly_1 = Union_box(
    xwidth = L1-2*e_cd,
    yheight = L1-2*e_cd,
    zdepth = e1-2*e_cd,
    priority = 20,
    material_string = "polyethylene_1",
    init = "init_1")
AT (0,0,0) RELATIVE arm1

COMPONENT cylindre_cd_1 = Union_cylinder(
    yheight = e1-epsilon,
    radius = r1+2*e_cd,
    priority = 30,
    material_string = "cadmium_1",
    init = "init_1")
AT (0,0,0) RELATIVE arm1
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cylindre_vacuum_1 = Union_cylinder(
    yheight = e1+epsilon,
    radius = r1,
    priority = 40,
    material_string = "Vacuum",
    init = "init_1")
AT (0,0,0) RELATIVE arm1
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT slit1_cd = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e_cd,
    priority = 50,
    material_string = "cadmium_1",
    init = "init_1")
AT (0,0,0.06) RELATIVE arm1

COMPONENT slit1_hole = Union_box(
    xwidth = 0.0035,
    yheight = 0.01,
    zdepth = e_cd+epsilon,
    priority = 60,
    material_string = "Vacuum",
    init = "init_1")
AT (0,0,0.06) RELATIVE arm1

COMPONENT master_1 = Union_master(init = "init_1")
AT (0,0,1) RELATIVE arm1

COMPONENT stop_1 = Union_stop()
AT (0,0,0) RELATIVE arm1


COMPONENT chopper = DiskChopper(
  xwidth = 0.001,
  radius = 0.07,
  yheight = 0.01,
  nu = 66.666,
  nslit = 1,
  isfirst = 1,
  n_pulse = 2
  )
AT (0,0,0.13) RELATIVE ABSOLUTE


COMPONENT arm2 = Arm()
AT (0,0,0.3065) RELATIVE chopper

COMPONENT init_2 = Union_init()
AT (0,0,0) RELATIVE arm2

COMPONENT diffusion_polyethylene_2 = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT diffusion_cd_2 = NCrystal_process(cfg = "Cd_sg194_cod9012436.ncmat", init="init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT polyethylene_2 = Union_make_material(
 process_string = "diffusion_polyethylene_2",
 init = "init_2",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm2

COMPONENT cadmium_2 = Union_make_material(
 process_string = "diffusion_cd_2",
 init = "init_2",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm2


COMPONENT slit2_cd = Union_box(
    xwidth = L1,
    yheight = L1,
    zdepth = e_cd,
    priority = 2,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,-L2/2-0.05) RELATIVE arm2

COMPONENT slit2_hole = Union_box(
    xwidth = 0.0035,
    yheight = 0.01,
    zdepth = e_cd+epsilon,
    priority = 3,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,-L2/2-0.05) RELATIVE arm2


/*==========================================================
  COLLIMATEUR 2
==========================================================*/

COMPONENT cd_tube_outer_2 = Union_cylinder(
    yheight = L2-epsilon,
    radius = r2_ext,
    priority = 10,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,0) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT cd_front_2 = Union_cylinder(
    yheight = e_cd,
    radius = r2_ext-epsilon,
    priority = 30,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,-L2/2+e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT cd_back_2 = Union_cylinder(
    yheight = e_cd,
    radius = r2_ext-epsilon,
    priority = 50,
    material_string = "cadmium_2",
    init = "init_2")
AT (0,0,L2/2-e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_front_2 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r2_ext-2*e_cd,
    priority = 70,
    material_string = "polyethylene_2",
    init = "init_2")
AT (0,0,-L2/2+e_poly/2+e_cd) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT poly_back_2 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r2_ext-2*e_cd,
    priority = 90,
    material_string = "polyethylene_2",
    init = "init_2")
AT (0,0,L2/2-e_poly/2-e_cd) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT front_void_2 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r2_int_in,
    priority = 100,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,-L2/2+e_poly/2+e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT back_void_2 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r2_int_out,
    priority = 110,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,L2/2-e_poly/2-e_cd/2) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT center_void_2 = Union_cylinder(
    yheight = L2-2*e_poly-2*e_cd+2*epsilon,
    radius = r2_ext-2*e_cd,
    priority = 120,
    material_string = "Vacuum",
    init = "init_2")
AT (0,0,0) RELATIVE arm2
ROTATED (90,0,0) RELATIVE ABSOLUTE


COMPONENT master_2 = Union_master(init = "init_2")
AT (0,0,0) RELATIVE arm2

COMPONENT stop_2 = Union_stop()
AT (0,0,0) RELATIVE arm2



/* ------------------------------------------------------------------
   Echantillon NCrystal
   diamètre = 30.1 mm
   épaisseur = 6.65 mm
   ------------------------------------------------------------------ */

COMPONENT sample = NCrystal_sample(
  cfg = "Cu_sg225.ncmat",
  radius = 0.01505,
  yheight = 0.00665,
  multscat = 0
)
WHEN (use_sample)
AT (0,0,0.315) RELATIVE arm2
ROTATED (90,0,0) RELATIVE arm2

COMPONENT Bg_poly = NCrystal_sample(
  cfg = "Polyethylene_CH2.ncmat",
  radius = 0.05,
  yheight = 0.10,
  multscat = 0
)
WHEN (use_sample=2)
AT (0,0,0.315) RELATIVE arm2
ROTATED (90,0,0) RELATIVE arm2

COMPONENT Bg_cd = NCrystal_sample(
  cfg = "Cd_sg194_cod9012436.ncmat",
  radius = 0.05,
  yheight = 0.001,
  multscat = 0
)
WHEN (use_sample=2)
AT (0,0,0.3655) RELATIVE arm2
ROTATED (90,0,0) RELATIVE arm2

COMPONENT arm3 = Arm()
AT (0,0,1.2235) RELATIVE arm2

COMPONENT init_3 = Union_init()
AT (0,0,0) RELATIVE arm3

COMPONENT diffusion_polyethylene_3 = NCrystal_process(cfg = "Polyethylene_CH2.ncmat", init="init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT diffusion_cd_3 = NCrystal_process(cfg = "Cd_sg194_cod9012436.ncmat", init="init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT polyethylene_3 = Union_make_material(
 process_string = "diffusion_polyethylene_3",
 init = "init_3",
 my_absorption = 0.2229)
AT (0,0,0) RELATIVE arm3

COMPONENT cadmium_3 = Union_make_material(
 process_string = "diffusion_cd_3",
 init = "init_3",
 my_absorption = 10230)
AT (0,0,0) RELATIVE arm3

/*==========================================================
  COLLIMATEUR 3
==========================================================*/

COMPONENT cd_tube_outer_3 = Union_cylinder(
    yheight = L3-epsilon,
    radius = r3_ext,
    priority = 10,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,0) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_front_3 = Union_cylinder(
    yheight = e_cd,
    radius = r3_ext-epsilon,
    priority = 30,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,-L3/2+e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT cd_back_3 = Union_cylinder(
    yheight = e_cd,
    radius = r3_ext-epsilon,
    priority = 50,
    material_string = "cadmium_3",
    init = "init_3")
AT (0,0,L3/2-e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_front_3 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r3_ext-2*e_cd,
    priority = 70,
    material_string = "polyethylene_3",
    init = "init_3")
AT (0,0,-L3/2+e_poly/2+e_cd) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT poly_back_3 = Union_cylinder(
    yheight = e_poly+epsilon,
    radius = r3_ext-2*e_cd,
    priority = 90,
    material_string = "polyethylene_3",
    init = "init_3")
AT (0,0,L3/2-e_poly/2-e_cd) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT front_void_3 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r3_int,
    priority = 100,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,-L3/2+e_poly/2+e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT back_void_3 = Union_cylinder(
    yheight = e_cd+e_poly+2*epsilon,
    radius = r3_int,
    priority = 110,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,L3/2-e_poly/2-e_cd/2) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT center_void_3 = Union_cylinder(
    yheight = L3-2*e_poly-2*e_cd+2*epsilon,
    radius = r3_ext-2*e_cd,
    priority = 120,
    material_string = "Vacuum",
    init = "init_3")
AT (0,0,0) RELATIVE arm3
ROTATED (90,0,0) RELATIVE ABSOLUTE

COMPONENT master_3 = Union_master(init = "init_3")
AT (0,0,0) RELATIVE arm3

COMPONENT stop_3 = Union_stop()
AT (0,0,0) RELATIVE arm3

/* ------------------------------------------------------------------
   TOF monitor
   6 inch * 3 inch = 15.24 cm * 7.62 cm
   ------------------------------------------------------------------ */

COMPONENT tof = TOF_efficiency_monitor(
  nt = 2000,
  xwidth = 0.1524,
  yheight = 0.0762,
  tmin = 0,
  tmax = 4000,
  restore_neutron=1
)
AT (0,0,0.3615) RELATIVE arm3

COMPONENT e = E_monitor(
  nE = 200,
  xwidth = 0.1524,
  yheight = 0.0762,
  Emin = 0,
  Emax = 305,
  restore_neutron=1
)
AT (0,0,0.00001) RELATIVE PREVIOUS

COMPONENT e_log = Monitor_nD(
  xwidth = 0.1524,
  yheight = 0.0762,
  options="log energy",   // log-spaced energy axis
  bins=1000,
  min=1,                   // meV
  max=10,              // meV
  filename="e_log.dat",
  restore_neutron=1)
AT (0,0,0.00001) RELATIVE PREVIOUS

COMPONENT mcpl = MCPL_output()
AT (0,0,0.00001) RELATIVE PREVIOUS



FINALLY
%{
%}

END

