@CELL
  lengths 2.9731 !! 5.6069
  angles 90 90 120
@SPACEGROUP
  194
@ATOMPOSITIONS
  Cd 1/3 2/3 1/4
  Cd 2/3 1/3 3/4
@DYNINFO
  # WARNING: Using fallback Debye temperature value!
  element Cd
  fraction 1
  type vdosdebye
  debye_temp 300
